source "https://rubygems.org"

# Theme files are copied into this repo (TeXt "common method"), so only Jekyll and plugins are needed.
gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
  gem "jekyll-feed"
  gem "jemoji"
end

# Ruby 3.4+ no longer bundles these (needed for local builds)
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "webrick"
